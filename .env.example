# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Récupérez ces valeurs depuis votre projet Supabase :
# https://supabase.com/dashboard/project/[votre-projet]/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# APPLICATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=15873276344

# ============================================
# STRIPE (paiements internationaux par carte)
# ============================================
# Récupérez ces valeurs depuis https://dashboard.stripe.com/apikeys
# Pour le dev, utilisez les clés de TEST (sk_test_, pk_test_).
# Pour la prod, basculez en clés LIVE (sk_live_, pk_live_).
#
# Note : si ces variables ne sont pas définies, les paiements via Stripe
# échouent avec une erreur explicite. Les autres méthodes (cash, mobile
# money) restent fonctionnelles sans Stripe.

STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook signature secret (à créer sur https://dashboard.stripe.com/webhooks)
# Endpoint à configurer : ${NEXT_PUBLIC_APP_URL}/api/payments/webhook/stripe
# Events à écouter : checkout.session.completed, checkout.session.expired,
#                    charge.refunded, charge.failed
STRIPE_WEBHOOK_SECRET=whsec_xxx
