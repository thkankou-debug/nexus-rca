# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Récupérez ces valeurs depuis votre projet Supabase :
# https://supabase.com/dashboard/project/[votre-projet]/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# APPLICATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=15873276344

# ============================================
# STRIPE (paiements internationaux par carte)
# ============================================
# https://dashboard.stripe.com/apikeys (TEST mode pour le dev)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook : créer sur https://dashboard.stripe.com/webhooks
# Endpoint : ${NEXT_PUBLIC_APP_URL}/api/payments/webhook/stripe
# Event : checkout.session.completed (suffit pour le flow simple)
STRIPE_WEBHOOK_SECRET=whsec_xxx
